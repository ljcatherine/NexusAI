# Against llama.cpp 620d2225: src/llama-sampler.cpp hunks only.
# Skips expf() below -104 (underflows to 0) in softmax and dist sampling.
diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 521c5718e..c48b96a83 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -290,6 +290,13 @@ static void llama_sampler_temp_impl(llama_token_data_array * cur_p, float temp)
     }
 }
 
+// expf underflows to exactly 0 below about -103.97, so skip the call there. The
+// PS5 libm takes a slow path on underflow, and a low temperature pushes most of
+// a large vocabulary into it (~20 ms per token over 262K entries).
+static inline float exp_or_zero(float x) {
+    return x < -104.0f ? 0.0f : expf(x);
+}
+
 static void llama_sampler_softmax_impl(llama_token_data_array * cur_p, bool do_sort) {
     GGML_ASSERT(cur_p->size > 0);
 
@@ -308,7 +315,7 @@ static void llama_sampler_softmax_impl(llama_token_data_array * cur_p, bool do_s
     float cum_sum = 0.0f;
 
     for (size_t i = 0; i < cur_p->size; ++i) {
-        float p = expf(cur_p->data[i].logit - max_l);
+        float p = exp_or_zero(cur_p->data[i].logit - max_l);
         cur_p->data[i].p = p;
         cum_sum += p;
     }
@@ -1184,7 +1191,7 @@ static void llama_sampler_dist_apply(struct llama_sampler * smpl, llama_token_da
     // apply softmax to obtain the probabilities
     double sum_cum = 0.0f;
     for (size_t i = 0; i < cur_p->size; ++i) {
-        float p = expf(cur_p->data[i].logit - max_l);
+        float p = exp_or_zero(cur_p->data[i].logit - max_l);
         cur_p->data[i].p = p;
         sum_cum += p;
     }
