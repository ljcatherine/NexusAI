+// ---- media mode ----------------------------------------------------------------------
+// model.txt whose first line is "media" starts the Nexus media engines (image,
+// video, speech, voice) on port 8083 instead of llama-server. Line 2 keeps the
+// LLM model to return to. The file is not used once, so media mode survives a
+// relaunch; a model choice or engine:llm replaces it.
+std::unique_ptr<MediaServer> g_media;
+
+bool media_requested() {
+    const auto lines = read_lines(kChoice.c_str());
+    return !lines.empty() && lines[0] == "media" && access(kArgs.c_str(), F_OK) != 0;
+}
+
+std::string media_return_model() {
+    const auto lines = read_lines(kChoice.c_str());
+    return lines.size() > 1 ? lines[1] : std::string();
+}
+
+// Before a restart or quit: stop the media API and free the engines' GPU memory.
+void stop_media() {
+    if (!g_media) {
+        return;
+    }
+    g_media->stop();
+    g_media.reset();
+    media_gpu_acquire(0);
+}
+
 // A quit request from the PC (scripts/ps5lm-app.sh close): the app ends
